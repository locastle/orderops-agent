# ---- LLM Providers (server-side only, never expose to browser) ----
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# Active provider: deepseek | minimax | cascade
LLM_PROVIDER=deepseek

# ---- Database ----
# Local (docker compose)
DATABASE_URL=postgresql+psycopg://orderops:orderops@localhost:5432/orderops
# Production (Neon, use the pooled connection string ending in -pooler)
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
DEMO_MODE=true
# Hard budget per diagnosis run
RUN_TOKEN_BUDGET=40000
RUN_TIME_BUDGET_SECONDS=90
MAX_TOOL_CALLS=12
